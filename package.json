{
  "name": "poc-ai-first-biblioteca",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "packages/modules/*",
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "docs:check": "tsx tools/docs-check/src/cli.ts",
    "contract:lint": "redocly lint",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "deps:check": "depcruise --config .dependency-cruiser.cjs packages apps tools",
    "test": "vitest run",
    "test:watch": "vitest",
    "mutation": "stryker run",
    "db:migrate": "tsx apps/api-node/src/migrate-cli.ts",
    "dev": "tsx apps/api-node/src/main.ts",
    "dev:web": "npm --workspace @biblioteca/web-react run dev",
    "demo": "bash .devcontainer/demo.sh",
    "build:api": "esbuild apps/api-node/src/main.ts --bundle --platform=node --format=esm --packages=external --outfile=apps/api-node/dist/main.mjs",
    "build:web": "npm --workspace @biblioteca/web-react run build",
    "build": "npm run typecheck && npm run build:api && npm run build:web"
  },
  "devDependencies": {
    "@redocly/cli": "^1.34.5",
    "@stryker-mutator/core": "^9.0.1",
    "@stryker-mutator/vitest-runner": "^9.0.1",
    "@types/node": "^22.14.0",
    "dependency-cruiser": "^16.10.2",
    "esbuild": "^0.25.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}
