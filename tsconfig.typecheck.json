{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "tools/**/*.ts",
    "packages/**/*.ts",
    "apps/api-node/**/*.ts",
    "apps/web-react/src/**/*.ts",
    "apps/web-react/src/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules/**",
    "**/dist/**",
    "scratch/**"
  ]
}
